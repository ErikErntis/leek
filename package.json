    "db:migrate": "pnpm --filter @leek/db migrate",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.9",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0"
  }
}
