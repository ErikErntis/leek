{
  "name": "@leek/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@hono/node-server": "^1.19.6",
    "@leek/auth": "workspace:*",
    "@leek/contracts": "workspace:*",
    "@leek/db": "workspace:*",
    "hono": "4.13.13",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@leek/config": "workspace:*",
    "drizzle-orm": "0.45.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6"
  }
}
