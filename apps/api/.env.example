PORT=3003
DEMO_MODE=true
# In production: DEMO_MODE=false and provide DATABASE_URL.
DATABASE_URL=postgresql://leek:leek@localhost:5432/leek
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Auth is available with DEMO_MODE=false and the migrated PostgreSQL database.
# This is the PUBLIC WEB origin, not the API address.
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique secret: openssl rand -base64 48
BETTER_AUTH_SECRET=
